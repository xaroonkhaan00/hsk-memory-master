{
  "name": "learn-hsk-3",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Learn HSK 3 — a local-first Mandarin learning app by Mian Fazli Basit (MFB).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "data": "python3 scripts/build_data.py",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "npm run build && node tests/smoke.mjs",
    "icons": "node scripts/make-icons.mjs",
    "android": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "playwright": "^1.62.1",
    "sharp": "^0.35.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
